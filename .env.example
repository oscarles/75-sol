# ── OBLIGATOIRE ──────────────────────────────────────────────────────────────
# Webhook Discord où partent les alertes « dev-buy 71–78 SOL »
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy

# ── OPTIONNEL : webhook séparé pour les logs de fonctionnement ───────────────
# (démarrage, créations, matchs, rejets, heartbeat). Vide = console uniquement.
DISCORD_LOG_WEBHOOK_URL=

# ── WebSocket Solana : détection (créations + trades) ───────────────────────
# Le WS public mainnet-beta marche mais rate-limit / drop souvent le firehose
# pump.fun. Pour ne rien rater, mets un WS dédié (Helius / QuickNode / Triton).
# Plusieurs URLs possibles, séparées par des virgules (bascule au reconnect).
PUBLIC_WS_URLS=wss://api.mainnet-beta.solana.com

# ─────────────────────────────────────────────────────────────────────────────
# LE FILTRE
# ─────────────────────────────────────────────────────────────────────────────
# Le dev (wallet créateur) doit s'acheter lui-même entre MIN et MAX SOL,
# dans les DEV_BUY_MAX_AGE_SEC secondes suivant la création du coin.
DEV_BUY_MIN_SOL=71
DEV_BUY_MAX_SOL=78
DEV_BUY_MAX_AGE_SEC=3

# true  = ne compter que les achats signés par le wallet créateur (recommandé)
# false = prendre le tout premier achat du coin comme dev-buy, quel qu'en soit
#         l'auteur (si le dev achète depuis un autre wallet)
DEV_BUY_REQUIRE_CREATOR_MATCH=true

# Tolérance en SOL sur les bornes (arrondis lamports / frais)
DEV_BUY_EPSILON_SOL=0.01

# Fast-path : si le dev-buy est DANS la tx de création, alerte immédiate sans
# attendre la fin de la fenêtre (~3 s gagnées). true recommandé.
DEV_BUY_FAST_PATH=true

# ── Ping « ALERTE » au-dessus de l'embed (pour un pote qui rate les notifs) ─
JOKE_PING_ENABLED=true
# ID Discord numérique du pote (mode dev → clic droit → « Copier l'identifiant »).
# Renseigné = vrai ping (notif + son). Vide = JOKE_PING_NAME en texte simple.
JOKE_PING_USER_ID=
JOKE_PING_NAME=@pilo0.
# GIF optionnel sous la ligne ALERTE (URL .gif directe ou lien tenor.com/view/…).
# Vide = pas de GIF.
JOKE_GIF_URL=

# ── Réglages de suivi (optionnels) ─────────────────────────────────────────
TOKEN_TTL_SEC=60
MAX_TRACKED=20000
EVAL_INTERVAL=0.5
RECONNECT_DELAY=5
